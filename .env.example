# .env racine : stack locale (docker compose + tests DB). Copier en .env et completer.
# Ne jamais y mettre de valeur de prod.

# --- Supabase local (stack CLI) ---
# Valeurs affichees par : npx supabase@2.122.1 status
SUPABASE_PUBLIC_URL=http://127.0.0.1:54321
ANON_KEY=
SERVICE_ROLE_KEY=

# --- Cles API applicatives (back), facultatives en local ---
REPLICATE_API_TOKEN=
OPENROUTER_API_KEY=
UNSPLASH_ACCESS_KEY=
GEMINI_API_KEY=

# --- Ingestion (profil docker "ingestion", gele pendant la phase 2) ---
BATCH_CRON=0 3 * * *
IKEA_COUNTRY=fr
IKEA_LANGUAGE=fr
IKEA_SEARCH_TERMS=canapé,bureau,chaise
IKEA_SEARCH_LIMIT=10
IKEA_TOKEN=
IKEA_DEBUG=false

# --- SonarQube (profil docker "sonar") ---
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=sonar
SONAR_DB_NAME=sonarqube
SONAR_DB_PORT=5433
SONAR_PORT=9000
